# Production origin used for canonical URLs, Open Graph URLs, JSON-LD, sitemap,
# and the Sitemap line in robots.txt. Use the Cloudflare Pages URL assigned to
# this project. Do not include a path or a trailing slash.
SITE_URL=https://your-project.pages.dev

# Optional public editorial email. Leave empty to show an honest "not configured"
# state on /contact/ instead of a form or a fake address.
PUBLIC_CONTACT_EMAIL=
