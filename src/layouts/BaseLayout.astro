---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
}

const {
  title = 'NalarTek — Understand Technology. Build What Matters.',
  description =
    'NalarTek is an independent technology media platform exploring Android, engineering, software, AI, and practical technology.',
  image = '/images/nalartek-og.png',
  type = 'website',
} = Astro.props;

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : null;
const ogImage = Astro.site ? new URL(image, Astro.site) : null;

const organizationSchema = Astro.site
  ? JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: 'NalarTek',
      url: Astro.site.href,
      logo: new URL('/images/nalartek-logo.png', Astro.site).href,
      slogan: 'Understand Technology. Build What Matters.',
      description,
    })
  : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#101d32" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content="NalarTek" />

    <title>{title}</title>

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap"
    />

    {canonical && <link rel="canonical" href={canonical.href} />}

    <meta property="og:site_name" content="NalarTek" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical.href} />}
    {ogImage && <meta property="og:image" content={ogImage.href} />}
    {ogImage && <meta property="og:image:type" content="image/png" />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    {ogImage && (
      <meta
        property="og:image:alt"
        content="NalarTek logo with the tagline Understand Technology. Build What Matters."
      />
    )}

    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage.href} />}

    {organizationSchema && (
      <script type="application/ld+json" set:html={organizationSchema} />
    )}
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
