---
import BaseLayout from '../layouts/BaseLayout.astro';

const email = import.meta.env.PUBLIC_CONTACT_EMAIL?.trim();
const hasEmail = Boolean(email && /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email));

// GANTI URL DI BAWAH INI DENGAN AKUN ANDA
const githubUrl = 'https://github.com/nalartek';
const xUrl = 'https://x.com/nalartek';

const breadcrumbs = [
  { label: 'Beranda', href: '/' },
  { label: 'Kontak' },
];
---

<BaseLayout
  title="Kontak"
  description="Hubungi NalarTek untuk koreksi, klarifikasi, pertanyaan editorial, atau masukan tentang artikel dan kebijakan publikasi."
  breadcrumbs={breadcrumbs}
>
  <div class="contact">
    <header class="hero">
      <div class="container">
        <nav class="crumbs rise" style="--d:0ms" aria-label="Breadcrumb">
          <a href="/">Beranda</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">Kontak</span>
        </nav>

        <p class="tag rise" style="--d:80ms">Kontak / Redaksi</p>
        <h1 class="rise" style="--d:160ms">Mari terhubung<span>.</span></h1>
        <p class="hero__lead rise" style="--d:260ms">
          NalarTek terbuka untuk masukan, koreksi faktual, klarifikasi teknis,
          maupun peluang kolaborasi. Kami percaya pada diskusi yang jujur tanpa
          sensasi.
        </p>
      </div>
    </header>

    <section class="container channels-section" aria-labelledby="kanal-title">
      <h2 class="sr-only" id="kanal-title">Kanal kontak</h2>

      <div class="channels">
        {hasEmail ? (
          <a class="channel channel--main rise" style="--d:340ms" href={`mailto:${email}`}>
            <span class="channel__idx">01</span>
            <span class="channel__label">Email Resmi</span>
            <span class="channel__value">{email}</span>
            <span class="channel__hint">
              Sertakan URL artikel, kutipan bagian yang dipermasalahkan, dan
              sumber pendukung bila mengirim koreksi.
            </span>
            <span class="channel__arrow" aria-hidden="true">↗</span>
          </a>
        ) : (
          <div class="channel channel--main channel--off rise" style="--d:340ms">
            <span class="channel__idx">01</span>
            <span class="channel__label">Email Resmi</span>
            <span class="channel__value">Segera hadir</span>
            <span class="channel__hint">
              Alamat email publik belum dikonfigurasi. Kami memilih tidak
              menampilkan formulir palsu atau alamat email yang tidak aktif.
              Halaman ini akan diperbarui setelah email resmi tersedia.
            </span>
          </div>
        )}

        <a class="channel rise" style="--d:420ms" href={githubUrl} target="_blank" rel="noopener noreferrer">
          <span class="channel__idx">02</span>
          <span class="channel__label">GitHub</span>
          <span class="channel__value">@nalartek</span>
          <span class="channel__hint">Repositori dan diskusi teknis.</span>
          <span class="channel__arrow" aria-hidden="true">↗</span>
        </a>

        <a class="channel rise" style="--d:500ms" href={xUrl} target="_blank" rel="noopener noreferrer">
          <span class="channel__idx">03</span>
          <span class="channel__label">X</span>
          <span class="channel__value">@nalartek</span>
          <span class="channel__hint">Kabar singkat dan percakapan terbuka.</span>
          <span class="channel__arrow" aria-hidden="true">↗</span>
        </a>
      </div>
    </section>

    <section class="container help" aria-labelledby="bantuan-title">
      <div class="help__head">
        <p class="idx">Panduan</p>
        <h2 class="t" id="bantuan-title">Agar pesan mudah ditindaklanjuti<span>.</span></h2>
      </div>

      <div class="help__body">
        <ol class="steps">
          <li><span>01</span>Tulis topik yang spesifik di baris subjek.</li>
          <li><span>02</span>Sertakan tautan dan kutipan bagian yang relevan.</li>
          <li><span>03</span>Jelaskan apakah Anda meminta koreksi, klarifikasi, atau hak jawab.</li>
          <li><span>04</span>Hindari melampirkan data pribadi yang tidak diperlukan.</li>
        </ol>

        <div class="note">
          <p class="note__label">Koreksi Faktual</p>
          <p>
            Jika sebuah klaim tidak akurat, sertakan sumber primer atau
            dokumentasi resmi. Koreksi yang terverifikasi akan ditangani sesuai
            kebijakan editorial.
          </p>
          <a href="/editorial-policy/">Kebijakan koreksi <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .contact {
    --sig: #18d6ff;
    --line: #1c2127;
    --char: #0b0d10;
    --muted: #aab2bb;
    --dim: #6b7580;
    --ink: #e9eef3;
    --display: 'Archivo', 'Arial Narrow', Impact, sans-serif;
    --mono: ui-monospace, 'JetBrains Mono', 'SFMono-Regular', Menlo, Consolas, monospace;
    background: #000;
    color: var(--muted);
    font-family: 'Manrope', system-ui, sans-serif;
    overflow-x: clip;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @keyframes rise {
    from { opacity: 0; transform: translateY(24px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .rise {
    animation: rise 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: var(--d, 0ms);
  }
  @media (prefers-reduced-motion: reduce) {
    .rise { animation: none; }
  }

  /* ---------- Hero ---------- */
  .hero {
    padding-block: clamp(6rem, 14vw, 10rem) clamp(2.5rem, 5vw, 4rem);
  }
  .crumbs {
    display: flex;
    gap: 0.6rem;
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
    font: 500 0.72rem/1 var(--mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dim);
  }
  .crumbs a { color: var(--dim); text-decoration: none; transition: color 0.2s; }
  .crumbs a:hover { color: var(--sig); }
  .crumbs [aria-current] { color: var(--muted); }

  .tag {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    margin: 0 0 1.5rem;
    font: 500 0.75rem/1 var(--mono);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--sig);
  }
  .tag::before { content: ''; width: 0.5rem; height: 0.5rem; background: var(--sig); }

  .hero h1 {
    margin: 0;
    font-family: var(--display);
    font-weight: 900;
    font-stretch: 87.5%;
    font-size: clamp(2.9rem, 10vw, 8rem);
    line-height: 0.9;
    letter-spacing: -0.035em;
    color: #fff;
    text-wrap: balance;
  }
  .hero h1 span { color: var(--sig); }
  .hero__lead {
    margin: 1.75rem 0 0;
    max-width: 52ch;
    font-size: 1.1rem;
    line-height: 1.7;
  }

  /* ---------- Kanal ---------- */
  .channels-section { padding-bottom: clamp(3.5rem, 8vw, 6rem); }
  .channels {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 860px) {
    .channels { grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr) minmax(0, 1fr); }
  }

  .channel {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    min-height: 15rem;
    padding: 1.5rem;
    background: #000;
    border: 1px solid var(--line);
    color: var(--muted);
    text-decoration: none;
    transition: border-color 0.18s, background 0.18s;
  }
  .channel__idx {
    font: 500 0.72rem/1 var(--mono);
    letter-spacing: 0.16em;
    color: var(--dim);
  }
  .channel__label {
    font: 500 0.75rem/1 var(--mono);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--sig);
  }
  .channel__value {
    margin-top: auto;
    font-family: var(--display);
    font-weight: 900;
    font-stretch: 87.5%;
    font-size: clamp(1.4rem, 2.6vw, 2rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: #fff;
    overflow-wrap: anywhere;
    transition: color 0.18s;
  }
  .channel__hint {
    font-size: 0.92rem;
    line-height: 1.6;
    max-width: 46ch;
  }
  .channel__arrow {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    font-family: var(--mono);
    color: var(--dim);
    transition: transform 0.18s, color 0.18s;
  }
  a.channel:hover,
  a.channel:focus-visible {
    border-color: var(--sig);
    background: var(--char);
    outline: none;
  }
  a.channel:hover .channel__value,
  a.channel:focus-visible .channel__value { color: var(--sig); }
  a.channel:hover .channel__arrow,
  a.channel:focus-visible .channel__arrow {
    color: var(--sig);
    transform: translate(3px, -3px);
  }
  .channel--off { border-style: dashed; }
  .channel--off .channel__value { color: var(--dim); }

  /* ---------- Panduan ---------- */
  .help {
    display: grid;
    gap: 2.5rem;
    padding-block: clamp(3.5rem, 8vw, 6rem);
    border-top: 1px solid var(--line);
  }
  @media (min-width: 900px) {
    .help {
      grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
      gap: 4rem;
    }
  }
  .idx {
    margin: 0 0 1.25rem;
    font: 500 0.75rem/1 var(--mono);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--dim);
  }
  .t {
    margin: 0;
    font-family: var(--display);
    font-weight: 900;
    font-stretch: 87.5%;
    font-size: clamp(1.9rem, 4.4vw, 3.2rem);
    line-height: 0.98;
    letter-spacing: -0.03em;
    color: #fff;
    text-wrap: balance;
  }
  .t span { color: var(--sig); }

  .steps {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .steps li {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr);
    align-items: baseline;
    padding-block: 1.1rem;
    border-bottom: 1px solid var(--line);
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--ink);
  }
  .steps li span {
    font: 500 0.75rem/1 var(--mono);
    letter-spacing: 0.16em;
    color: var(--sig);
  }

  .note {
    margin-top: 2rem;
    padding: 1.5rem;
    border: 1px solid var(--line);
  }
  .note p { margin: 0 0 1rem; font-size: 0.98rem; line-height: 1.7; max-width: 58ch; }
  .note .note__label {
    margin-bottom: 0.75rem;
    font: 500 0.75rem/1 var(--mono);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--sig);
  }
  .note a {
    font: 500 0.78rem/1 var(--mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--sig);
    text-decoration: none;
  }
  .note a:hover { text-decoration: underline; text-underline-offset: 0.3em; }
</style>
