---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

const email = import.meta.env.PUBLIC_CONTACT_EMAIL?.trim();
const hasEmail = Boolean(email && /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email));

const breadcrumbs = [
  { label: 'Beranda', href: '/' },
  { label: 'Kontak' },
];
---

<BaseLayout
  title="Kontak"
  description="Hubungi NalarTek untuk koreksi, klarifikasi, pertanyaan editorial, atau masukan tentang artikel dan kebijakan publikasi."
  breadcrumbs={breadcrumbs}
>
  <PageHero
    eyebrow="Kontak"
    title="Mari terhubung dan berdiskusi."
    description="NalarTek terbuka untuk masukan, koreksi faktual, klarifikasi teknis, maupun peluang kolaborasi. Kami percaya pada diskusi yang jujur tanpa sensasi."
    breadcrumbs={breadcrumbs}
  />

  <section class="section" aria-labelledby="kanal-title">
    <div class="container contact-layout">
      <div class="contact-main">
        <p class="eyebrow">Kanal Utama</p>
        <h2 class="content-title" id="kanal-title">
          Hubungi Redaksi<span>.</span>
        </h2>

        {hasEmail ? (
          <div class="contact-channel">
            <span class="contact-channel__label">Email Resmi</span>
            <a class="contact-email" href={`mailto:${email}`}>{email}</a>
            <p>
              Sertakan URL artikel, kutipan bagian yang dipermasalahkan, dan
              sumber pendukung bila mengirim koreksi. Pesan tanpa konteks lebih
              sulit ditindaklanjuti.
            </p>
          </div>
        ) : (
          <div class="contact-channel contact-channel--empty">
            <span class="contact-channel__label">Email Resmi (Segera Hadir)</span>
            <p>
              Saat ini, alamat email publik NalarTek belum dikonfigurasi. Kami
              memilih untuk tidak menampilkan formulir palsu atau alamat email
              yang tidak aktif. 
            </p>
            <p>
              Sebagai gantinya, Anda dapat menghubungi pendiri dan tim redaksi melalui
              kanal alternatif di bawah ini. Halaman ini akan segera diperbarui
              setelah email resmi tersedia.
            </p>
          </div>
        )}

        <div style="margin-top: 3rem;">
          <p class="eyebrow">Kanal Alternatif</p>
          <div style="display: flex; gap: 1rem; margin-top: 1rem; flex-wrap: wrap;">
            <!-- GANTI URL DI BAWAH INI DENGAN AKUN ANDA -->
            <a class="button button-secondary" href="https://github.com/nalartek" target="_blank" rel="noopener noreferrer">
              GitHub Repositori
            </a>
            <a class="button button-secondary" href="https://x.com/nalartek" target="_blank" rel="noopener noreferrer">
              X (Twitter)
            </a>
          </div>
          <p style="font-size: 0.85rem; color: var(--color-text-muted); margin-top: 1rem;">
            *Jika tautan di atas belum sesuai dengan akun Anda, Anda dapat mengubahnya langsung di file <code>contact.astro</code>.
          </p>
        </div>
      </div>

      <aside class="contact-aside" aria-labelledby="bantuan-title">
        <h2 id="bantuan-title">Agar pesan mudah ditindaklanjuti</h2>
        <ul>
          <li>Tulis topik yang spesifik di baris subjek.</li>
          <li>Sertakan tautan dan kutipan bagian yang relevan.</li>
          <li>Jelaskan apakah Anda meminta koreksi, klarifikasi, atau hak jawab.</li>
          <li>Hindari melampirkan data pribadi yang tidak diperlukan.</li>
        </ul>

        <div class="contact-aside__note">
          <strong>Koreksi Faktual</strong>
          <p>
            Jika sebuah klaim tidak akurat, sertakan sumber primer atau
            dokumentasi resmi. Koreksi yang terverifikasi akan ditangani sesuai
            kebijakan editorial.
          </p>
          <a class="text-link" href="/editorial-policy/">
            Kebijakan koreksi <span aria-hidden="true">↗</span>
          </a>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
