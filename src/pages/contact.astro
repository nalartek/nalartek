---
import BaseLayout from '../layouts/BaseLayout.astro';

const email = import.meta.env.PUBLIC_CONTACT_EMAIL?.trim();
const hasEmail = Boolean(email && /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email));

// GANTI URL DI BAWAH INI DENGAN AKUN ANDA
const githubUrl = 'https://github.com/nalartek';
const xUrl = 'https://x.com/nalartek';

const breadcrumbs = [
  { label: 'Beranda', href: '/' },
  { label: 'Kontak' },
];

const cards = [
  hasEmail
    ? {
        idx: '01', label: 'Email Resmi', value: email, href: `mailto:${email}`,
        hint: 'Sertakan URL artikel, kutipan bagian yang dipermasalahkan, dan sumber pendukung bila mengirim koreksi.',
        cmd: 'kirim_pesan', ext: false, off: false,
      }
    : {
        idx: '01', label: 'Email Resmi', value: 'Segera hadir', href: '',
        hint: 'Alamat email publik belum dikonfigurasi. Kami memilih tidak menampilkan formulir palsu atau alamat email yang tidak aktif. Halaman ini akan diperbarui setelah email resmi tersedia.',
        cmd: 'menunggu_kunci', ext: false, off: true,
      },
  { idx: '02', label: 'GitHub', value: '@nalartek', href: githubUrl, hint: 'Repositori dan diskusi teknis.', cmd: 'buka_repositori', ext: true, off: false },
  { idx: '03', label: 'X', value: '@nalartek', href: xUrl, hint: 'Kabar singkat dan percakapan terbuka.', cmd: 'buka_percakapan', ext: true, off: false },
];
const online = cards.filter((c) => !c.off).length;
---

<BaseLayout
  title="Kontak"
  description="Hubungi NalarTek untuk koreksi, klarifikasi, pertanyaan editorial, atau masukan tentang artikel dan kebijakan publikasi."
  breadcrumbs={breadcrumbs}
>
  <div class="contact">
    <header class="hero">
      <span class="hero__ghost" aria-hidden="true">HUBUNGI</span>
      <div class="container">
        <nav class="crumbs" data-reveal aria-label="Breadcrumb">
          <a href="/">Beranda</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">Kontak</span>
        </nav>
        <p class="tag" data-reveal style="--d:80ms">Kontak / Redaksi</p>
        <h1 data-reveal style="--d:160ms">Mari <br />terhubung<span>.</span></h1>
      </div>
      <div class="ruler" aria-hidden="true"></div>
    </header>

    <section class="container console" aria-labelledby="kanal-title">
      <div class="intro" data-reveal style="--d:100ms">
        <p class="prompt" aria-hidden="true">$ ./hubungi --redaksi</p>
        <p class="intro__lead">
          NalarTek terbuka untuk masukan, koreksi faktual, klarifikasi teknis,
          maupun peluang kolaborasi. Kami percaya pada diskusi yang jujur tanpa
          sensasi.
        </p>
        <dl class="readout">
          <div><dt>Kanal terdaftar</dt><dd>03</dd></div>
          <div><dt>Kanal aktif</dt><dd><i class="led" aria-hidden="true"></i>0{online}/03</dd></div>
          <div><dt>Bahasa</dt><dd>Indonesia</dd></div>
          <div><dt>Fokus</dt><dd>Koreksi · Klarifikasi · Kolaborasi</dd></div>
        </dl>
      </div>

      <div class="channels">
        <h2 class="sr-only" id="kanal-title">Kanal kontak</h2>
        {cards.map((c, i) => c.off ? (
          <div class="channel channel--off" data-reveal style={`--d:${140 + i * 100}ms`}>
            <span class="channel__head">
              <span class="channel__idx" aria-hidden="true">CH-{c.idx}</span>
              <span class="channel__label">{c.label}</span>
              <span class="channel__state"><i class="led" aria-hidden="true"></i>Offline</span>
            </span>
            <span class="channel__body">
              <span class="redact" aria-hidden="true"><i style="width:34%"></i><b>@</b><i style="width:26%"></i><b>.</b><i style="width:12%"></i></span>
              <span class="channel__value">{c.value}</span>
              <span class="channel__hint">{c.hint}</span>
            </span>
            <span class="channel__foot">
              <span class="channel__cmd" aria-hidden="true">{c.cmd}</span>
              <span class="stamp">Encrypted</span>
            </span>
          </div>
        ) : (
          <a
            class="channel"
            data-reveal
            style={`--d:${140 + i * 100}ms`}
            href={c.href}
            target={c.ext ? '_blank' : undefined}
            rel={c.ext ? 'noopener noreferrer' : undefined}
          >
            <span class="channel__head">
              <span class="channel__idx" aria-hidden="true">CH-{c.idx}</span>
              <span class="channel__label">{c.label}</span>
              <span class="channel__state"><i class="led" aria-hidden="true"></i>Online</span>
            </span>
            <span class="channel__body">
              <span class="channel__value">{c.value}</span>
              <span class="channel__hint">{c.hint}</span>
              {c.ext && <span class="sr-only"> (buka di tab baru)</span>}
            </span>
            <span class="channel__foot">
              <span class="channel__cmd" aria-hidden="true">{c.cmd}</span>
              <span class="channel__go" aria-hidden="true"></span>
            </span>
            <span class="channel__ticks" aria-hidden="true"></span>
          </a>
        ))}
      </div>
    </section>

    <section class="container help" aria-labelledby="bantuan-title">
      <div class="help__head" data-reveal>
        <p class="idx">Panduan</p>
        <h2 class="t" id="bantuan-title">Agar pesan mudah ditindaklanjuti<span>.</span></h2>
      </div>

      <div class="help__body">
        <ol class="steps">
          <li data-reveal><span>01</span>Tulis topik yang spesifik di baris subjek.</li>
          <li data-reveal style="--d:70ms"><span>02</span>Sertakan tautan dan kutipan bagian yang relevan.</li>
          <li data-reveal style="--d:140ms"><span>03</span>Jelaskan apakah Anda meminta koreksi, klarifikasi, atau hak jawab.</li>
          <li data-reveal style="--d:210ms"><span>04</span>Hindari melampirkan data pribadi yang tidak diperlukan.</li>
        </ol>

        <div class="note" data-reveal>
          <p class="note__label">Koreksi Faktual</p>
          <div class="note__body">
            <p>
              Jika sebuah klaim tidak akurat, sertakan sumber primer atau
              dokumentasi resmi. Koreksi yang terverifikasi akan ditangani sesuai
              kebijakan editorial.
            </p>
            <a href="/editorial-policy/">Kebijakan koreksi <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </div>
    </section>
  </div>

  <script>
    const items = document.querySelectorAll<HTMLElement>('.contact [data-reveal]');
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('is-in');
              io.unobserve(e.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: '0px 0px -6% 0px' }
      );
      items.forEach((el) => io.observe(el));
    } else {
      items.forEach((el) => el.classList.add('is-in'));
    }
  </script>
</BaseLayout>

<style>
  .contact {
    --sig: #18d6ff;
    --line: #1c2127;
    --char: #0b0d10;
    --muted: #aab2bb;
    --dim: #6b7580;
    --ink: #e9eef3;
    --display: 'Archivo', 'Arial Narrow', Impact, sans-serif;
    --mono: ui-monospace, 'JetBrains Mono', 'SFMono-Regular', Menlo, Consolas, monospace;
    background: #000;
    color: var(--muted);
    font-family: 'Manrope', system-ui, sans-serif;
    overflow-x: clip;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* ---------- Animasi ---------- */
  @keyframes ct-blink { 50% { opacity: 0; } }
  @keyframes ct-sweep {
    from { transform: translateY(-100%); }
    to { transform: translateY(var(--travel, 300%)); }
  }
  @keyframes ct-drift {
    from { transform: translateX(-50%); }
    to { transform: translateX(-54%); }
  }
  @keyframes ct-glitch {
    0%, 100% { opacity: 1; }
    40% { opacity: 0.3; }
    45% { opacity: 1; }
    70% { opacity: 0.55; }
    72% { opacity: 1; }
  }
  @keyframes ct-in {
    from { opacity: 0; transform: translateY(28px); }
    to { opacity: 1; transform: none; }
  }
  @media (scripting: enabled) and (prefers-reduced-motion: no-preference) {
    [data-reveal] { opacity: 0; }
    [data-reveal].is-in { animation: ct-in 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) var(--d, 0ms) both; }
  }
  @media (prefers-reduced-motion: reduce) {
    .contact *, .contact *::before, .contact *::after { animation: none !important; }
  }

  .led {
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    margin-right: 0.5rem;
    background: var(--sig);
    animation: ct-blink 1.6s steps(1) infinite;
  }

  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-top: clamp(6rem, 14vw, 10rem);
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(rgba(24, 214, 255, 0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgba(24, 214, 255, 0.07) 1px, transparent 1px);
    background-size: 72px 72px;
    -webkit-mask-image: radial-gradient(ellipse 85% 80% at 75% 35%, #000 10%, transparent 72%);
    mask-image: radial-gradient(ellipse 85% 80% at 75% 35%, #000 10%, transparent 72%);
  }
  .hero::after {
    content: '';
    --travel: 340%;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    z-index: -1;
    height: 30%;
    pointer-events: none;
    background:
      linear-gradient(rgba(24, 214, 255, 0.5), rgba(24, 214, 255, 0.5)) bottom / 100% 1px no-repeat,
      linear-gradient(to bottom, transparent, rgba(24, 214, 255, 0.06));
    transform: translateY(-100%);
    animation: ct-sweep 9s linear infinite;
  }
  .hero__ghost {
    position: absolute;
    left: 50%;
    bottom: clamp(2rem, 6vw, 4.5rem);
    z-index: -1;
    font-family: var(--display);
    font-weight: 900;
    font-stretch: 87.5%;
    font-size: clamp(4.5rem, 21vw, 24rem);
    line-height: 0.78;
    letter-spacing: -0.04em;
    color: transparent;
    -webkit-text-stroke: 1px rgba(24, 214, 255, 0.22);
    white-space: nowrap;
    user-select: none;
    pointer-events: none;
    transform: translateX(-50%);
    animation: ct-drift 18s ease-in-out infinite alternate;
  }
  .crumbs {
    display: flex;
    gap: 0.6rem;
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
    font: 500 0.72rem/1 var(--mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dim);
  }
  .crumbs a { color: var(--dim); text-decoration: none; transition: color 0.2s; }
  .crumbs a:hover { color: var(--sig); }
  .crumbs [aria-current] { color: var(--muted); }

  .tag {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    margin: 0 0 1.5rem;
    font: 500 0.75rem/1 var(--mono);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--sig);
  }
  .tag::before { content: ''; width: 0.5rem; height: 0.5rem; background: var(--sig); }

  .hero h1 {
    margin: 0;
    font-family: var(--display);
    font-weight: 900;
    font-stretch: 87.5%;
    font-size: clamp(2.6rem, 12.5vw, 10.5rem);
    line-height: 0.86;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    color: #fff;
  }
  .hero h1 span { color: var(--sig); animation: ct-blink 1.2s steps(1) infinite; }

  .ruler {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    height: 0.65rem;
    border-top: 1px solid var(--line);
    background: repeating-linear-gradient(90deg, var(--line) 0 1px, transparent 1px 12px);
  }

  /* ---------- Konsol: intro + kanal ---------- */
  .console {
    display: grid;
    gap: 2.5rem;
    padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(3.5rem, 8vw, 6rem);
  }
  @media (min-width: 960px) {
    .console {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: clamp(3rem, 6vw, 6rem);
      align-items: start;
    }
    .intro { position: sticky; top: 7rem; }
  }

  .prompt {
    margin: 0 0 1.25rem;
    font: 500 0.75rem/1 var(--mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--sig);
  }
  .prompt::after {
    content: '';
    display: inline-block;
    width: 0.55em;
    height: 1em;
    margin-left: 0.5em;
    vertical-align: -0.15em;
    background: var(--sig);
    animation: ct-blink 1.1s steps(1) infinite;
  }
  .intro__lead {
    margin: 0;
    max-width: 46ch;
    padding-left: 1.25rem;
    border-left: 2px solid var(--sig);
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
    line-height: 1.75;
    color: var(--ink);
  }

  .readout { margin: 2rem 0 0; border: 1px solid var(--line); }
  .readout::before {
    content: 'SYS.STATUS';
    display: block;
    padding: 0.75rem 1rem;
    background: var(--char);
    border-bottom: 1px solid var(--line);
    font: 500 0.7rem/1 var(--mono);
    letter-spacing: 0.18em;
    color: var(--sig);
  }
  .readout div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--line);
    font: 500 0.74rem/1.5 var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .readout div:last-child { border-bottom: 0; }
  .readout dt { color: var(--dim); }
  .readout dd { margin: 0; text-align: right; color: var(--ink); }

  /* ---------- Kartu kanal ---------- */
  .channels { display: grid; gap: 1rem; }

  .channel {
    --b: linear-gradient(var(--sig), var(--sig));
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: #000;
    border: 1px solid var(--line);
    color: var(--muted);
    text-decoration: none;
    transition: border-color 0.18s, background 0.18s;
  }
  .channel::after {
    content: '';
    --travel: 255%;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 40%;
    opacity: 0;
    pointer-events: none;
    background:
      var(--b) bottom / 100% 1px no-repeat,
      linear-gradient(to bottom, transparent, rgba(24, 214, 255, 0.09));
    transform: translateY(-100%);
  }
  .channel__head,
  .channel__foot {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.75rem 1.1rem;
    font: 500 0.7rem/1 var(--mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    transition: border-color 0.18s, color 0.18s;
  }
  .channel__head { background: var(--char); border-bottom: 1px solid var(--line); }
  .channel__foot { justify-content: space-between; border-top: 1px solid var(--line); color: var(--dim); }
  .channel__idx { color: var(--dim); }
  .channel__label { color: var(--sig); }
  .channel__state { display: inline-flex; align-items: center; margin-left: auto; color: var(--muted); }
  .channel__state .led { margin-right: 0.5rem; }

  .channel__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.8rem;
    padding: 1.6rem 1.25rem 1.5rem;
  }
  .channel__value {
    font-family: var(--display);
    font-weight: 900;
    font-stretch: 87.5%;
    font-size: clamp(1.5rem, 3.4vw, 2.3rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: #fff;
    overflow-wrap: anywhere;
    transition: color 0.18s;
  }
  .channel__hint { max-width: 50ch; font-size: 0.92rem; line-height: 1.65; }

  .channel__cmd::before { content: '> '; color: var(--sig); }
  .channel__cmd::after {
    content: '';
    display: inline-block;
    width: 0.5em;
    height: 1em;
    margin-left: 0.5em;
    vertical-align: -0.2em;
    background: currentColor;
    opacity: 0;
  }
  .channel__go {
    position: relative;
    width: 1.75rem;
    height: 1px;
    background: currentColor;
    transition: width 0.25s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .channel__go::after {
    content: '';
    position: absolute;
    right: 0;
    top: -3px;
    width: 7px;
    height: 7px;
    border: solid currentColor;
    border-width: 1px 1px 0 0;
    transform: rotate(45deg);
  }
  .channel__ticks {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.18s;
    background:
      var(--b) 0 0 / 14px 2px no-repeat, var(--b) 0 0 / 2px 14px no-repeat,
      var(--b) 100% 0 / 14px 2px no-repeat, var(--b) 100% 0 / 2px 14px no-repeat,
      var(--b) 0 100% / 14px 2px no-repeat, var(--b) 0 100% / 2px 14px no-repeat,
      var(--b) 100% 100% / 14px 2px no-repeat, var(--b) 100% 100% / 2px 14px no-repeat;
  }

  a.channel:is(:hover, :focus-visible) { border-color: var(--sig); background: var(--char); }
  a.channel:focus-visible { outline: 2px solid var(--sig); outline-offset: 3px; }
  a.channel:is(:hover, :focus-visible)::after { opacity: 1; animation: ct-sweep 1.5s linear infinite; }
  a.channel:is(:hover, :focus-visible) .channel__ticks { opacity: 1; }
  a.channel:is(:hover, :focus-visible) .channel__value { color: var(--sig); }
  a.channel:is(:hover, :focus-visible) .channel__head { border-color: rgba(24, 214, 255, 0.4); }
  a.channel:is(:hover, :focus-visible) .channel__foot { border-color: rgba(24, 214, 255, 0.4); color: var(--sig); }
  a.channel:is(:hover, :focus-visible) .channel__go { width: 3.5rem; }
  a.channel:is(:hover, :focus-visible) .channel__cmd::after { opacity: 1; animation: ct-blink 1s steps(1) infinite; }

  /* Email: OFFLINE / ENCRYPTED */
  .channel--off { background: repeating-linear-gradient(135deg, #000 0 9px, var(--char) 9px 10px); }
  .channel--off .channel__label,
  .channel--off .channel__value { color: var(--dim); }
  .channel--off .led { background: var(--dim); animation-duration: 2.6s; }
  .channel--off .channel__cmd { color: var(--muted); }
  .channel--off .channel__cmd::after { opacity: 1; animation: ct-blink 1.2s steps(1) infinite; }
  .redact {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font: 500 0.9rem/1 var(--mono);
    color: var(--dim);
  }
  .redact i { height: 1rem; background: #262d34; animation: ct-glitch 3.4s steps(1) infinite; }
  .redact i:nth-child(3) { animation-delay: -1.1s; }
  .redact i:nth-child(5) { animation-delay: -2.2s; }
  .stamp {
    padding: 0.35rem 0.55rem;
    border: 1px solid var(--dim);
    letter-spacing: 0.2em;
    color: var(--dim);
  }

  /* ---------- Panduan ---------- */
  .help {
    display: grid;
    gap: 2.5rem;
    padding-block: clamp(3.5rem, 8vw, 6rem);
    border-top: 1px solid var(--line);
  }
  @media (min-width: 900px) {
    .help { grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: 4rem; }
  }
  .idx {
    margin: 0 0 1.25rem;
    font: 500 0.75rem/1 var(--mono);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--dim);
  }
  .t {
    margin: 0;
    font-family: var(--display);
    font-weight: 900;
    font-stretch: 87.5%;
    font-size: clamp(1.9rem, 4.4vw, 3.2rem);
    line-height: 0.98;
    letter-spacing: -0.03em;
    color: #fff;
    text-wrap: balance;
  }
  .t span { color: var(--sig); }

  .steps { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--line); }
  .steps li {
    position: relative;
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr);
    align-items: baseline;
    padding-block: 1.1rem;
    border-bottom: 1px solid var(--line);
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--ink);
    transition: background 0.18s, padding 0.18s;
  }
  .steps li::before {
    content: '';
    position: absolute;
    left: 0;
    top: -1px;
    bottom: -1px;
    width: 2px;
    background: var(--sig);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.2s;
  }
  .steps li:hover { background: var(--char); padding-left: 0.9rem; }
  .steps li:hover::before { transform: scaleY(1); }
  .steps li span { font: 500 0.75rem/1 var(--mono); letter-spacing: 0.16em; color: var(--sig); }
  .steps li span::before { content: '['; color: var(--dim); }
  .steps li span::after { content: ']'; color: var(--dim); }

  .note { margin-top: 2rem; border: 1px solid var(--line); }
  .note__label {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin: 0;
    padding: 0.75rem 1.25rem;
    background: var(--char);
    border-bottom: 1px solid var(--line);
    font: 500 0.72rem/1 var(--mono);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--sig);
  }
  .note__label::before { content: ''; width: 0.45rem; height: 0.45rem; background: var(--sig); }
  .note__body { padding: 1.5rem 1.25rem; }
  .note__body p { margin: 0 0 1rem; max-width: 58ch; font-size: 0.98rem; line-height: 1.7; }
  .note a {
    font: 500 0.78rem/1 var(--mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
