---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCover from '../../components/ArticleCover.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CategoryBadge from '../../components/CategoryBadge.astro';
import RelatedArticles from '../../components/RelatedArticles.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import {
  countWords,
  formatDate,
  getPublishedArticles,
  getReadingTime,
  getRelatedArticles,
  toIsoDate,
  type ArticleEntry,
} from '../../lib/articles';
import { getCategory } from '../../lib/categories';

export async function getStaticPaths() {
  const articles = await getPublishedArticles();

  return articles.map((article) => ({
    params: { slug: article.data.slug },
    props: { article, articles },
  }));
}

interface Props {
  article: ArticleEntry;
  articles: ArticleEntry[];
}

const { article, articles } = Astro.props;
const { Content, headings } = await render(article);
const category = getCategory(article.data.category);

if (!category) {
  throw new Error(`Kategori tidak dikenal: ${article.data.category}`);
}

const readingTime = getReadingTime(article.body ?? '');
const wordCount = countWords(article.body ?? '');
const related = getRelatedArticles(article, articles);

const breadcrumbs = [
  { label: 'Beranda', href: '/' },
  { label: 'Artikel', href: '/articles/' },
  { label: category.name, href: `/categories/${category.slug}/` },
  { label: article.data.title },
];

const articleMeta = {
  headline: article.data.title,
  publishedTime: toIsoDate(article.data.pubDate),
  modifiedTime: article.data.updatedDate
    ? toIsoDate(article.data.updatedDate)
    : undefined,
  author: article.data.author,
  section: category.name,
  tags: article.data.tags,
  wordCount,
  readingTimeMinutes: readingTime,
};
---

<BaseLayout
  title={article.data.title}
  description={article.data.description}
  image={article.data.coverImage?.src}
  imageAlt={article.data.coverImage?.alt}
  imageWidth={article.data.coverImage?.width}
  imageHeight={article.data.coverImage?.height}
  type="article"
  article={articleMeta}
  breadcrumbs={breadcrumbs}
>
  <article class="article">
    <header class="article-header">
      <div class="container article-header__inner">
        <Breadcrumbs items={breadcrumbs} />

        <div class="article-header__meta">
          <CategoryBadge category={article.data.category} />
          {article.data.starter && <span class="starter-label">Starter</span>}
        </div>

        <h1>{article.data.title}</h1>
        <p class="article-deck">{article.data.description}</p>

        <div class="article-byline">
          <span class="byline-mark" aria-hidden="true">N</span>
          <div class="byline-copy">
            <span class="byline-author">{article.data.author}</span>
            <span>
              <time datetime={toIsoDate(article.data.pubDate)}>
                {formatDate(article.data.pubDate)}
              </time>
              <span aria-hidden="true"> · </span>
              {readingTime} menit baca
            </span>
          </div>
          {article.data.updatedDate && (
            <span class="byline-updated">
              Diperbarui{' '}
              <time datetime={toIsoDate(article.data.updatedDate)}>
                {formatDate(article.data.updatedDate)}
              </time>
            </span>
          )}
        </div>
      </div>
    </header>

    <div class="container article-layout">
      <aside class="article-sidebar">
        <TableOfContents headings={headings} />

        <div class="sidebar-note">
          <span class="sidebar-note__label">Kategori</span>
          <a href={`/categories/${category.slug}/`}>{category.name}</a>
          <p>{category.description}</p>
        </div>

        <div class="sidebar-note">
          <span class="sidebar-note__label">Koreksi</span>
          <p>
            Menemukan kesalahan atau informasi yang perlu diperbarui? Sampaikan
            melalui halaman kontak.
          </p>
          <a class="text-link" href="/contact/">
            Hubungi editorial <span aria-hidden="true">↗</span>
          </a>
        </div>
      </aside>

      <div class="article-main">
        <ArticleCover article={article} eager class="article-hero-cover" />

        {article.data.starter && (
          <aside class="starter-disclosure" aria-label="Keterangan artikel starter">
            <strong>Artikel starter NalarTek.</strong>
            <span>
              Tulisan ini adalah contoh awal untuk menguji sistem publikasi,
              bukan liputan peristiwa terkini. Klaim teknisnya merujuk pada
              sumber yang tertaut di bagian Sumber.
            </span>
          </aside>
        )}

        <div class="prose">
          <Content />
        </div>

        <footer class="article-footer">
          <ul class="article-tags" aria-label="Tag artikel">
            {article.data.tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>

          <div class="article-footer__links">
            <a class="text-link" href={`/categories/${category.slug}/`}>
              Semua {category.name} <span aria-hidden="true">↗</span>
            </a>
            <a class="text-link" href="/articles/">
              Arsip artikel <span aria-hidden="true">↗</span>
            </a>
            <a class="text-link" href="/contact/">
              Laporkan koreksi <span aria-hidden="true">↗</span>
            </a>
          </div>
        </footer>
      </div>
    </div>
  </article>

  <RelatedArticles articles={related} />
</BaseLayout>
