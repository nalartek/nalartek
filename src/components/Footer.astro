---
import { categories } from '../lib/categories';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <figure class="brand-banner">
      <img
        src="/images/nalartek-banner-lockup-1440.png"
        srcset="/images/nalartek-banner-lockup-720.png 720w, /images/nalartek-banner-lockup-1440.png 1440w"
        sizes="(max-width: 960px) calc(100vw - 40px), 920px"
        width="1440"
        height="600"
        alt="Logo NalarTek dengan slogan Understand Technology. Build What Matters."
        loading="lazy"
        decoding="async"
      />
    </figure>
  </div>

  <div class="container footer-main">
    <div class="footer-brand">
      <a class="brand" href="/" aria-label="NalarTek — beranda">
        <img
          class="brand-logo"
          src="/images/nalartek-logo-128.png"
          srcset="/images/nalartek-logo-128.png 1x, /images/nalartek-logo-256.png 2x"
          width="128"
          height="128"
          alt=""
          aria-hidden="true"
          loading="lazy"
          decoding="async"
        />
        <span class="brand-wordmark" aria-hidden="true">NALAR<span>TEK</span></span>
      </a>
      <p class="footer-tagline">
        Media teknologi independen dari Indonesia. Membahas Android,
        engineering, Linux, AI, software, dan inovasi secara praktis.
      </p>
    </div>

    <div class="footer-columns">
      <nav class="footer-column" aria-label="Navigasi utama footer">
        <h2 class="footer-heading">Jelajahi</h2>
        <a href="/articles/">Semua artikel</a>
        <a href="/categories/">Kategori</a>
        <a href="/about/">Tentang NalarTek</a>
        <a href="/contact/">Kontak</a>
      </nav>

      <nav class="footer-column" aria-label="Kategori footer">
        <h2 class="footer-heading">Kategori</h2>
        {categories.map((category) => (
          <a href={`/categories/${category.slug}/`}>{category.name}</a>
        ))}
      </nav>

      <nav class="footer-column" aria-label="Informasi editorial footer">
        <h2 class="footer-heading">Editorial</h2>
        <a href="/editorial-policy/">Kebijakan editorial</a>
        <a href="/contact/">Koreksi & masukan</a>
        <a href="/about/">Prinsip kami</a>
      </nav>
    </div>
  </div>

  <div class="container footer-bottom">
    <span>© {year} NalarTek. Hak cipta dilindungi.</span>
    <a href="#top">Kembali ke atas ↑</a>
  </div>
</footer>
