---
import ArticleCover from './ArticleCover.astro';
import CategoryBadge from './CategoryBadge.astro';
import type { ArticleEntry } from '../lib/articles';
import {
  formatDate,
  getArticlePath,
  getReadingTime,
  toIsoDate,
} from '../lib/articles';

interface Props {
  article: ArticleEntry;
  compact?: boolean;
  lead?: boolean;
  eager?: boolean;
  index?: number;
}

const {
  article,
  compact = false,
  lead = false,
  eager = false,
  index,
} = Astro.props;

const href = getArticlePath(article.data.slug);
const readingTime = getReadingTime(article.body ?? '');
const number =
  typeof index === 'number' ? String(index).padStart(2, '0') : null;
---

<article
  class:list={[
    'ncard',
    { 'ncard--compact': compact, 'ncard--lead': lead },
  ]}
>
  {number && (
    <span class="ncard__number" aria-hidden="true">{number}</span>
  )}

  {!compact && (
    <div class="ncard__media">
      <ArticleCover article={article} eager={eager} />
    </div>
  )}

  <div class="ncard__content">
    <div class="ncard__meta">
      <CategoryBadge category={article.data.category} link={false} />
      <time datetime={toIsoDate(article.data.pubDate)}>
        {formatDate(article.data.pubDate)}
      </time>
      <span>{readingTime} menit baca</span>
      {article.data.starter && <span class="ncard__starter">Starter</span>}
    </div>

    <h3 class="ncard__title">
      <a href={href}>{article.data.title}</a>
    </h3>

    {!compact && (
      <p class="ncard__excerpt">{article.data.description}</p>
    )}

    <span class="ncard__more" aria-hidden="true">
      Baca artikel <span>↗</span>
    </span>
  </div>
</article>

<style>
  .ncard {
    --signal: #18d6ff;
    --ink: #f4f6f8;
    --mute: #8b949e;
    --soft: #aab2bb;
    --line: #ffffff24;
    --ease: cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding-block: 1.25rem 1rem;
    border-top: 1px solid var(--line);
    color: var(--ink);
    font-family: 'Manrope', system-ui, sans-serif;
  }

  /* garis sinyal yang menyapu di atas kartu */
  .ncard::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    width: 100%;
    height: 1px;
    background: var(--signal);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.7s var(--ease);
  }

  /* angka besar di latar */
  .ncard__number {
    position: absolute;
    right: 0;
    bottom: -0.15em;
    z-index: -1;
    font-family: 'Archivo', 'Arial Narrow', Impact, sans-serif;
    font-weight: 900;
    font-stretch: 87.5%;
    font-size: clamp(5rem, 11vw, 8rem);
    line-height: 0.8;
    letter-spacing: -0.05em;
    color: transparent;
    -webkit-text-stroke: 1px #ffffff1f;
    pointer-events: none;
    user-select: none;
    transition: -webkit-text-stroke-color 0.5s var(--ease);
  }

  .ncard__media {
    overflow: hidden;
    border: 1px solid var(--line);
  }

  .ncard__media :global(img) {
    display: block;
    transition: transform 1s var(--ease);
  }

  .ncard__content {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .ncard__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 1rem;
    font-size: 0.72rem;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--mute);
  }

  .ncard__starter {
    padding: 0.1rem 0.5rem;
    border: 1px solid var(--signal);
    color: var(--signal);
  }

  .ncard__title {
    margin: 0;
    font-family: 'Archivo', 'Arial Narrow', Impact, sans-serif;
    font-weight: 800;
    font-stretch: 87.5%;
    font-size: clamp(1.4rem, 2.4vw, 1.85rem);
    line-height: 1.08;
    letter-spacing: -0.015em;
    text-wrap: balance;
    transition: transform 0.6s var(--ease), color 0.3s var(--ease);
  }

  .ncard__title a {
    color: inherit;
    text-decoration: none;
  }

  /* seluruh kartu bisa diklik */
  .ncard__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .ncard__title a:focus-visible {
    outline: none;
  }

  .ncard:has(a:focus-visible) {
    outline: 2px solid var(--signal);
    outline-offset: 6px;
  }

  .ncard:focus-within::before {
    transform: scaleX(1);
  }

  .ncard:focus-within .ncard__title {
    color: var(--signal);
  }

  .ncard__excerpt {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
    max-width: 38rem;
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--soft);
  }

  .ncard__more {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--mute);
    transition: color 0.3s var(--ease);
  }

  .ncard__more span {
    display: inline-block;
    transition: transform 0.4s var(--ease);
  }

  /* ---------- varian compact ---------- */
  .ncard--compact {
    gap: 0.75rem;
  }

  .ncard--compact .ncard__title {
    font-size: clamp(1.25rem, 1.9vw, 1.55rem);
  }

  .ncard--compact .ncard__number {
    font-size: clamp(3.5rem, 7vw, 5rem);
  }

  /* ---------- varian lead ---------- */
  .ncard--lead {
    gap: 1.75rem;
    padding-top: 1.5rem;
  }

  .ncard--lead .ncard__content {
    gap: 1.1rem;
  }

  .ncard--lead .ncard__title {
    font-size: clamp(2rem, 4.8vw, 3.9rem);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .ncard--lead .ncard__excerpt {
    -webkit-line-clamp: 4;
    line-clamp: 4;
    max-width: 42rem;
    font-size: clamp(1rem, 1.4vw, 1.1rem);
  }

  .ncard--lead .ncard__number {
    font-size: clamp(7rem, 17vw, 14rem);
  }

  /* ---------- hover hanya di perangkat yang mendukung ---------- */
  @media (hover: hover) and (pointer: fine) {
    .ncard:hover::before {
      transform: scaleX(1);
    }
    .ncard:hover .ncard__title {
      transform: translateX(0.5rem);
      color: var(--signal);
    }
    .ncard:hover .ncard__number {
      -webkit-text-stroke-color: #18d6ff66;
    }
    .ncard:hover .ncard__more {
      color: var(--signal);
    }
    .ncard:hover .ncard__more span {
      transform: translate(0.2rem, -0.2rem);
    }
    .ncard:hover .ncard__media :global(img) {
      transform: scale(1.04);
    }
  }

  /* feedback sentuh untuk layar tanpa hover */
  @media (hover: none) {
    .ncard:active .ncard__title {
      color: var(--signal);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ncard::before,
    .ncard__number,
    .ncard__title,
    .ncard__more,
    .ncard__more span,
    .ncard__media :global(img) {
      transition: none;
    }
  }
</style>
