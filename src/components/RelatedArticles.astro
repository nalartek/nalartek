---
import ArticleCard from './ArticleCard.astro';
import type { ArticleEntry } from '../lib/articles';

interface Props {
  articles: ArticleEntry[];
}

const { articles } = Astro.props;
---

{
  articles.length > 0 && (
    <section class="related-articles" aria-labelledby="related-title">
      <div class="container">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Lanjutkan membaca</p>
            <h2 class="section-title" id="related-title">
              Artikel terkait<span>.</span>
            </h2>
          </div>
          <a class="text-link" href="/articles/">
            Semua artikel <span aria-hidden="true">↗</span>
          </a>
        </div>

        <div class="article-grid">
          {articles.map((article) => (
            <ArticleCard article={article} />
          ))}
        </div>
      </div>
    </section>
  )
}
