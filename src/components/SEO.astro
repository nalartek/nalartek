---
import type { ArticleMeta, BreadcrumbItem } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  imageType?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  article?: ArticleMeta;
  breadcrumbs?: BreadcrumbItem[];
}

const {
  title,
  description,
  image = '/images/nalartek-og.png',
  imageAlt = 'NalarTek, media teknologi independen dengan slogan Understand Technology. Build What Matters.',
  imageWidth = 1200,
  imageHeight = 630,
  imageType,
  type = 'website',
  noindex = false,
  article,
  breadcrumbs = [],
} = Astro.props;

const siteName = 'NalarTek';
const siteDescription =
  'NalarTek adalah media teknologi independen yang membahas Android, engineering, Linux, AI, software, dan inovasi secara praktis.';
const site = Astro.site;
const canonicalPath = Astro.url.pathname.endsWith('/')
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const canonical = site && !noindex ? new URL(canonicalPath, site) : null;
const imageUrl = site && image ? new URL(image, site) : null;

const extension = image.split('.').pop()?.toLowerCase();
const inferredImageType =
  imageType ??
  (extension === 'jpg' || extension === 'jpeg'
    ? 'image/jpeg'
    : extension === 'webp'
      ? 'image/webp'
      : extension === 'avif'
        ? 'image/avif'
        : 'image/png');

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: siteName,
  ...(site ? { url: site.href } : {}),
  ...(site
    ? { logo: new URL('/images/nalartek-logo.png', site).href }
    : {}),
  slogan: 'Understand Technology. Build What Matters.',
  description: siteDescription,
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteName,
  ...(site ? { url: site.href } : {}),
  inLanguage: 'id-ID',
  description: siteDescription,
};

const articleSchema =
  type === 'article' && article
    ? {
        '@context': 'https://schema.org',
        '@type': 'Article',
        headline: article.headline ?? title,
        description,
        ...(canonical
          ? { url: canonical.href, mainEntityOfPage: canonical.href }
          : {}),
        ...(imageUrl ? { image: [imageUrl.href] } : {}),
        datePublished: article.publishedTime,
        dateModified: article.modifiedTime ?? article.publishedTime,
        author: {
          '@type': 'Organization',
          name: article.author,
        },
        publisher: {
          '@type': 'Organization',
          name: siteName,
          ...(site
            ? {
                logo: {
                  '@type': 'ImageObject',
                  url: new URL('/images/nalartek-logo.png', site).href,
                },
              }
            : {}),
        },
        articleSection: article.section,
        keywords: article.tags.join(', '),
        inLanguage: 'id-ID',
        isAccessibleForFree: true,
        ...(article.wordCount ? { wordCount: article.wordCount } : {}),
        ...(article.readingTimeMinutes
          ? { timeRequired: `PT${article.readingTimeMinutes}M` }
          : {}),
      }
    : null;

const breadcrumbSchema =
  site && breadcrumbs.length > 1
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: breadcrumbs.map((item, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          name: item.label,
          item: item.href
            ? new URL(item.href, site).href
            : (canonical?.href ?? site.href),
        })),
      }
    : null;

const schemaCandidates: Array<Record<string, unknown> | null> = [
  organizationSchema,
  websiteSchema,
  articleSchema,
  breadcrumbSchema,
];
const schemas = schemaCandidates.filter(
  (schema): schema is Record<string, unknown> => schema !== null,
);

function serializeSchema(schema: Record<string, unknown>) {
  return JSON.stringify(schema).replace(/</g, '\\u003c');
}
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="theme-color" content="#101d32" />
<meta name="color-scheme" content="dark" />
<meta name="description" content={description} />
<meta name="author" content={article?.author ?? 'NalarTek Editorial'} />
<meta name="generator" content={Astro.generator} />
<meta
  name="robots"
  content={noindex
    ? 'noindex, nofollow'
    : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
/>

<title>{title}</title>

<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="sitemap" type="application/xml" href="/sitemap.xml" />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Manrope:wght@400..800&display=swap"
/>

{canonical && <link rel="canonical" href={canonical.href} />}

<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content="id_ID" />
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{canonical && <meta property="og:url" content={canonical.href} />}
{imageUrl && <meta property="og:image" content={imageUrl.href} />}
{imageUrl && <meta property="og:image:type" content={inferredImageType} />}
{imageUrl && <meta property="og:image:width" content={String(imageWidth)} />}
{imageUrl && <meta property="og:image:height" content={String(imageHeight)} />}
{imageUrl && <meta property="og:image:alt" content={imageAlt} />}

{article && (
  <meta property="article:published_time" content={article.publishedTime} />
)}
{article?.modifiedTime && (
  <meta property="article:modified_time" content={article.modifiedTime} />
)}
{article && <meta property="article:author" content={article.author} />}
{article && <meta property="article:section" content={article.section} />}
{article?.tags.map((tag) => (
  <meta property="article:tag" content={tag} />
))}

<meta
  name="twitter:card"
  content={imageUrl ? 'summary_large_image' : 'summary'}
/>
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{imageUrl && <meta name="twitter:image" content={imageUrl.href} />}
{imageUrl && <meta name="twitter:image:alt" content={imageAlt} />}

{schemas.map((schema) => (
  <script type="application/ld+json" set:html={serializeSchema(schema)} />
))}
