---
/* ==========================================================================
   NalarTek — Header v2
   Sticky. Transparan di atas halaman, berubah jadi kaca (blur) saat di-scroll.
   Desktop: nav dengan garis penanda yang bergeser. Mobile: menu layar penuh.
   Progress baca hanya muncul di halaman artikel.
   ========================================================================== */
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';

const links = [
  { href: '/articles/', label: 'Artikel' },
  { href: '/categories/', label: 'Kategori' },
  { href: '/about/', label: 'Tentang' },
  { href: '/contact/', label: 'Kontak' },
];

const minor = [
  { href: '/editorial-policy/', label: 'Kebijakan editorial' },
  { href: '/privacy-policy/', label: 'Kebijakan privasi' },
  { href: '/terms/', label: 'Syarat & ketentuan' },
];

const isCurrent = (href: string) => {
  const base = href.replace(/\/+$/, '');
  return path === base || path.startsWith(`${base}/`);
};

const showProgress = /^\/articles\/[^/]+/.test(path);
---

<script is:inline>document.documentElement.classList.add('js');</script>

<a class="skip-link" href="#main">Lewati ke konten</a>

{showProgress && (
  <div class="progress" aria-hidden="true">
    <span data-progress></span>
  </div>
)}

<header class="site-header" data-header>
  <div class="container site-header__bar">
    <a class="brand" href="/" aria-label="NalarTek, ke beranda">
      <img class="brand__logo" src="/images/nalartek-logo-128.png" alt="" width="32" height="32" decoding="async" />
      <span class="brand__name">NALAR<span>TEK</span></span>
    </a>

    <nav class="nav" aria-label="Navigasi utama" data-nav>
      <ul class="nav__list">
        {links.map((item) => (
          <li>
            <a class="nav__link" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <span class="nav__indicator" data-nav-indicator aria-hidden="true"></span>
    </nav>
<div class="site-header__end">
  <a class="btn btn--accent btn--sm site-header__cta" href="/articles/">Baca artikel</a>
  <button
    class="menu-toggle"
    type="button"
    aria-expanded="false"
    aria-controls="mobile-menu"
    aria-label="Buka menu"
    data-menu-toggle
  ></button>
</div>
  </div>
</header>

<div class="mobile-menu" id="mobile-menu" data-menu inert>
  <div class="container mobile-menu__inner">
    <nav aria-label="Menu utama seluler">
      <ul class="mobile-menu__list">
        {links.map((item, i) => (
          <li class="mobile-menu__item" style={`--i:${i}`}>
            <a class="mobile-menu__link" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <ul class="mobile-menu__minor">
      {minor.map((item) => (
        <li><a href={item.href}>{item.label}</a></li>
      ))}
    </ul>
  </div>
</div>

<style>
  /* Progress baca */
  .progress {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: var(--z-progress);
    height: 2px;
    pointer-events: none;
  }
  .progress > span {
    display: block;
    height: 100%;
    background: var(--accent);
    transform: scaleX(var(--p, 0));
    transform-origin: 0 50%;
  }

  /* Header + kaca saat scroll */
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    padding-top: env(safe-area-inset-top, 0px);
  }
  .site-header::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--glass);
    border-bottom: 1px solid var(--line);
    -webkit-backdrop-filter: blur(18px) saturate(160%);
    backdrop-filter: blur(18px) saturate(160%);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--dur-2) var(--ease-out);
  }
  .site-header.is-scrolled::before {
    opacity: 1;
  }
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .site-header::before {
      background: rgb(0 0 0 / 0.94);
    }
  }

  .site-header__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    height: var(--header-h);
  }

  /* Brand */
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    flex: none;
  }
  .brand__logo {
    width: 2rem;
    height: 2rem;
    object-fit: contain;
  }
  .brand__name {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 800;
    font-stretch: 90%;
    line-height: 1;
    letter-spacing: 0.02em;
    color: var(--text);
  }
  .brand__name span {
    color: var(--accent);
  }

  /* Nav desktop */
  .nav {
    --pad: 1rem;
    position: relative;
    display: none;
    margin-left: auto;
    margin-right: var(--space-5);
  }
  .nav__list {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nav__link {
    display: block;
    padding: 0.55rem var(--pad);
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--text-muted);
    transition: color var(--dur-2) var(--ease-out);
  }
  .nav__link:hover,
  .nav__link:focus-visible,
  .nav__link[aria-current="page"] {
    color: var(--text);
  }
  .nav__indicator {
    position: absolute;
    left: 0;
    bottom: 0;
    width: calc(var(--w, 0px) - var(--pad) * 2);
    height: 2px;
    background: var(--accent);
    transform: translateX(calc(var(--x, 0px) + var(--pad)));
    opacity: 0;
    pointer-events: none;
  }
  .nav__indicator[data-ready] {
    transition:
      transform var(--dur-3) var(--ease-out),
      width var(--dur-3) var(--ease-out),
      opacity var(--dur-2) var(--ease-out);
  }

  /* Aksi kanan */
  .site-header__end {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex: none;
  }
  .site-header__end > .site-header__cta {
    display: none;
  }

  .menu-toggle {
    position: relative;
    width: 2.75rem;
    height: 2.75rem;
    color: var(--text);
    border: 1px solid var(--line-strong);
    transition: border-color var(--dur-2) var(--ease-out);
  }
  .menu-toggle[aria-expanded="true"] {
    border-color: var(--accent);
  }
  .menu-toggle__bar {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 1.125rem;
    height: 2px;
    margin: -1px 0 0 -0.5625rem;
    background: currentColor;
    transition: transform var(--dur-3) var(--ease-out);
  }
  .menu-toggle__bar:nth-child(1) { transform: translateY(-4px); }
  .menu-toggle__bar:nth-child(2) { transform: translateY(4px); }
  .menu-toggle[aria-expanded="true"] .menu-toggle__bar:nth-child(1) { transform: rotate(45deg); }
  .menu-toggle[aria-expanded="true"] .menu-toggle__bar:nth-child(2) { transform: rotate(-45deg); }

  /* Menu layar penuh (mobile) */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: var(--z-menu);
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--bg);
    clip-path: inset(0 0 100% 0);
    visibility: hidden;
    transition:
      clip-path var(--dur-4) var(--ease-in-out),
      visibility 0s linear var(--dur-4);
  }
  .mobile-menu[data-open="true"] {
    clip-path: inset(0);
    visibility: visible;
    transition:
      clip-path var(--dur-4) var(--ease-in-out),
      visibility 0s;
  }
  .mobile-menu__inner {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-8);
    min-height: 100%;
    padding-top: calc(var(--header-h) + env(safe-area-inset-top, 0px) + var(--space-6));
    padding-bottom: calc(var(--space-7) + env(safe-area-inset-bottom, 0px));
  }
  .mobile-menu__list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .mobile-menu__item {
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }
  .mobile-menu__link {
    display: block;
    padding: 0.18em 0 0.1em;
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 14vw, 5rem);
    font-weight: 800;
    font-stretch: 80%;
    line-height: 1.02;
    letter-spacing: -0.03em;
    color: var(--text);
    transform: translateY(105%);
    transition:
      transform var(--dur-3) var(--ease-out),
      color var(--dur-2) var(--ease-out);
  }
  .mobile-menu[data-open="true"] .mobile-menu__link {
    transform: none;
    transition-delay: calc(var(--i, 0) * var(--stagger) + 200ms), 0ms;
  }
  .mobile-menu__link[aria-current="page"],
  .mobile-menu__link:active {
    color: var(--accent);
  }
  .mobile-menu__minor {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
    opacity: 0;
    transition: opacity var(--dur-3) var(--ease-out);
  }
  .mobile-menu[data-open="true"] .mobile-menu__minor {
    opacity: 1;
    transition-delay: 500ms;
  }
  .mobile-menu__minor a {
    font-size: var(--fs-sm);
    color: var(--text-muted);
  }

  @media (min-width: 48em) {
    .nav { display: block; }
    .site-header__end > .site-header__cta { display: inline-flex; }
    .menu-toggle { display: none; }
    .mobile-menu { display: none; }
  }
</style>

<script>
  const root = document.documentElement;
  const header = document.querySelector('[data-header]');

  if (header) {
    /* 1. Kaca saat scroll + progress baca */
    const bar = document.querySelector('[data-progress]');
    let ticking = false;

    const paint = () => {
      const y = Math.max(0, window.scrollY);
      const max = root.scrollHeight - window.innerHeight;
      header.classList.toggle('is-scrolled', y > 8);
      if (bar) bar.style.setProperty('--p', max > 0 ? Math.min(1, y / max).toFixed(4) : '0');
      ticking = false;
    };

    const onScroll = () => {
      if (ticking === false) {
        ticking = true;
        requestAnimationFrame(paint);
      }
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    paint();

    /* 2. Garis penanda navigasi yang berpindah */
    const nav = header.querySelector('[data-nav]');
    const indicator = nav ? nav.querySelector('[data-nav-indicator]') : null;

    if (nav && indicator) {
      const links = Array.from(nav.querySelectorAll('.nav__link'));
      const current = nav.querySelector('[aria-current="page"]');
      let ready = false;

      const moveTo = (el) => {
        if (el === null) {
          indicator.style.opacity = '0';
          return;
        }
        indicator.style.setProperty('--x', el.offsetLeft + 'px');
        indicator.style.setProperty('--w', el.offsetWidth + 'px');
        indicator.style.opacity = '1';
        if (ready === false) {
          ready = true;
          requestAnimationFrame(() =>
            requestAnimationFrame(() => indicator.setAttribute('data-ready', ''))
          );
        }
      };

      links.forEach((link) => {
        link.addEventListener('pointerenter', () => moveTo(link));
        link.addEventListener('focus', () => moveTo(link));
      });
      nav.addEventListener('pointerleave', () => moveTo(current));
      nav.addEventListener('focusout', (e) => {
        if (nav.contains(e.relatedTarget) === false) moveTo(current);
      });
      window.addEventListener('resize', () => moveTo(current));
      if (document.fonts && document.fonts.ready) {
        document.fonts.ready.then(() => moveTo(current));
      }
      moveTo(current);
    }

    /* 3. Menu layar penuh (mobile) */
    const menu = document.querySelector('[data-menu]');
    const toggle = header.querySelector('[data-menu-toggle]');

    if (menu && toggle) {
      const desktop = window.matchMedia('(min-width: 48em)');
      const pageParts = document.querySelectorAll('main, [data-site-footer]');

      const setOpen = (open) => {
        toggle.setAttribute('aria-expanded', String(open));
        toggle.setAttribute('aria-label', open ? 'Tutup menu' : 'Buka menu');
        menu.setAttribute('data-open', String(open));
        menu.inert = open === false;
        pageParts.forEach((el) => {
          el.inert = open;
        });
        root.classList.toggle('is-locked', open);
      };

      toggle.addEventListener('click', () => {
        setOpen(toggle.getAttribute('aria-expanded') === 'false');
      });
      menu.addEventListener('click', (e) => {
        if (e.target.closest('a')) setOpen(false);
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
          setOpen(false);
          toggle.focus();
        }
      });
      desktop.addEventListener('change', (e) => {
        if (e.matches) setOpen(false);
      });
    }
  }
</script>
