---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import FeaturedArticle from '../components/FeaturedArticle.astro';
import {
  getCategoryStats,
  getFeaturedArticles,
  getLatestArticles,
  getPublishedArticles,
} from '../lib/articles';

const articles = await getPublishedArticles();
const featured = getFeaturedArticles(articles, 3);
const leadArticle = featured[0];
const secondaryFeatured = featured.slice(1);
const latest = getLatestArticles(
  articles,
  3,
  featured.map((article) => article.data.slug),
);
const categoryStats = getCategoryStats(articles);
---

<BaseLayout
  description="NalarTek adalah media teknologi independen dari Indonesia. Baca panduan dan analisis praktis tentang Android, engineering, Linux, AI, software, dan inovasi."
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">
          <span class="status-dot" aria-hidden="true"></span>
          Media teknologi independen
        </p>

        <h1 id="hero-title">
          Pahami<br />
          teknologi.<br />
          <span>Bangun yang<br />berarti.</span>
        </h1>

        <p class="hero-lede">
          Panduan dan analisis praktis tentang Android, engineering, Linux,
          AI, software, serta inovasi yang berdampak nyata.
        </p>

        <div class="hero-actions">
          <a class="button button-primary" href="/articles/">
            Jelajahi artikel <span aria-hidden="true">↗</span>
          </a>
          <a class="button button-secondary" href="/about/">
            Tentang NalarTek
          </a>
        </div>

        <p class="hero-note">
          <span aria-hidden="true"></span>
          Dipahami. Diuji. Didokumentasikan.
        </p>
      </div>

      <div class="hero-visual" aria-hidden="true">
        <div class="visual-grid"></div>
        <div class="visual-orbit orbit-one"></div>
        <div class="visual-orbit orbit-two"></div>
        <div class="hero-logo-frame">
          <img
            src="/images/nalartek-logo.png"
            width="800"
            height="800"
            alt=""
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </div>
        <span class="visual-label label-top">NALARTEK / MARK 001</span>
        <span class="visual-label label-bottom">
          ANDROID · LINUX · AI · INNOVATION
        </span>
        <span class="visual-cross cross-one">+</span>
        <span class="visual-cross cross-two">+</span>
      </div>
    </div>

    <div class="container hero-footer" aria-hidden="true">
      <span>01</span>
      <span class="index-line"></span>
      <span>04</span>
    </div>
  </section>

  {
    leadArticle && (
      <section class="section featured-section" aria-labelledby="featured-title">
        <div class="container">
          <div class="section-heading">
            <div>
              <p class="eyebrow">01 / Sorotan</p>
              <h2 class="section-title" id="featured-title">
                Yang layak dibaca<span>.</span>
              </h2>
            </div>
            <a class="text-link" href="/articles/">
              Semua artikel <span aria-hidden="true">↗</span>
            </a>
          </div>

          <div
            class:list={[
              'featured-layout',
              { 'featured-layout--single': secondaryFeatured.length === 0 },
            ]}
          >
            <FeaturedArticle article={leadArticle} />
            {secondaryFeatured.length > 0 && (
              <div class="featured-side">
                {secondaryFeatured.map((article) => (
                  <ArticleCard article={article} compact />
                ))}
              </div>
            )}
          </div>
        </div>
      </section>
    )
  }

  {
    latest.length > 0 && (
      <section class="section" aria-labelledby="latest-title">
        <div class="container">
          <div class="section-heading">
            <div>
              <p class="eyebrow">02 / Terbaru</p>
              <h2 class="section-title" id="latest-title">
                Catatan terbaru<span>.</span>
              </h2>
            </div>
            <p class="section-description">
              Tulisan baru dari ruang belajar dan eksperimen NalarTek.
            </p>
          </div>

          <div class="article-grid">
            {latest.map((article) => (
              <ArticleCard article={article} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="section" id="topics" aria-labelledby="topics-title">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">03 / Kategori</p>
          <h2 class="section-title" id="topics-title">
            Area fokus<span>.</span>
          </h2>
        </div>
        <a class="text-link" href="/categories/">
          Jelajahi kategori <span aria-hidden="true">↗</span>
        </a>
      </div>

      <div class="category-grid">
        {categoryStats.map((category) => (
          <a class="category-card" href={`/categories/${category.slug}/`}>
            <div class="category-top">
              <span>{category.number} / Kategori</span>
              <span class="category-arrow" aria-hidden="true">↗</span>
            </div>
            <h3>{category.name}</h3>
            <p>{category.description}</p>
            <div class="category-bottom">
              <span>{category.count} artikel</span>
              <span class="bottom-line" aria-hidden="true"></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="manifesto" aria-labelledby="manifesto-title">
    <div class="container">
      <p class="eyebrow">Prinsip NalarTek</p>
      <h2 id="manifesto-title">
        Jangan hanya memakai teknologi.<br />
        <span>Pahami. Uji. Bangun.</span>
      </h2>
      <p>
        NalarTek adalah media teknologi independen yang menempatkan pemahaman,
        verifikasi, dan penggunaan praktis di atas kebisingan.
      </p>
      <a class="text-link manifesto-link" href="/about/">
        Baca prinsip editorial <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
</BaseLayout>
